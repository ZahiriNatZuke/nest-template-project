{
  "name": "nest-template-project",
  "version": "1.0.0",
  "description": "Template Project of NestJS + Fastify + Prisma + Passport + Pino + Zod",
  "author": {
    "name": "Yohan González Almaguer",
    "email": "yohan.gonzalez.almaguer@gmail.com",
    "url": "https://www.linkedin.com/in/yohan-gonzalez-almaguer/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZahiriNatZuke/nest-template-project.git"
  },
  "private": false,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start -b swc --watch",
    "start:debug": "nest start -b swc --debug --watch",
    "start:prod": "node dist/src/main",
    "migrate:deploy": "prisma migrate deploy",
    "format": "biome format --fix",
    "lint": "biome check --fix --unsafe",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.ts --runInBand",
    "prepare": "husky",
    "precommit": "pnpm run lint && pnpm run format",
    "serve": "pnpm run precommit && pnpm run build && pnpm run start:prod"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/rate-limit": "11.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "6.0.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "lodash": "4.18.1",
    "nestjs-pino": "4.6.1",
    "otplib": "13.4.1",
    "passport": "0.7.0",
    "passport-headerapikey": "1.2.2",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rotating-file-stream": "3.2.9",
    "rxjs": "7.8.2",
    "zod": "4.4.3",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.47",
    "@swc/jest": "0.2.39",
    "@types/bcrypt": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "26.1.2",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@types/zxcvbn": "4.4.5",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
