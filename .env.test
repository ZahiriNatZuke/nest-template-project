# Environment used by the Jest test suites (unit and e2e).
#
# These values are intentionally committed: they are throwaway credentials that
# only ever point at a disposable local/CI database. Never reuse them anywhere
# else — real secrets belong in an untracked .env file.

ENVIRONMENT="test"
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nest_template_test?schema=public"
PORT=3001
HOST="localhost"
ORIGINS="http://localhost:3001"
RATE_LIMIT_WINDOWS=60000
RATE_LIMIT_MAX=100000

JWT_SECRET="test_jwt_secret_do_not_use_outside_of_tests_0123456789"
EXPIRESIN_ACCESS="15m"
JWT_VERIFICATION_TOKEN_SECRET="test_verification_secret_do_not_use_outside_of_tests_0123456789"
JWT_VERIFICATION_TOKEN_EXPIRATION_TIME="15m"
JWT_REFRESH_TOKEN_SECRET="test_refresh_secret_do_not_use_outside_of_tests_0123456789"
EXPIRESIN_REFRESH="7d"

EMAIL_CONFIRMATION_URL="http://localhost:3001/confirm-account"
RECOVERY_ACCOUNT_URL="http://localhost:3001/password-change"

ADMIN_PASSWORD="TestAdminPassw0rd!"

SWAGGER_VERSION="1.0.0"
APP_NAME="Nest Template Project Test"

MAIL_USER="support@test.local"
MAIL_FROM="support@test.local"

HEADER_KEY_API_KEY="X-API-KEY"
WEB_APP_API_KEY="test_web_app_api_key_0123456789"
MOBILE_APP_API_KEY="test_mobile_app_api_key_0123456789"

PINO_LOG_LEVEL="silent"

MAX_CONCURRENT_SESSIONS=5

ENCRYPTION_SECRET="test_encryption_secret_0123456789abcdef"
